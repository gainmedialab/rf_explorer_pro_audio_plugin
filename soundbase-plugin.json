{
  "manifestVersion": 1,
  "id": "rf-explorer-pro-audio",
  "name": "RF Explorer Pro Audio Edition",
  "version": "0.1.0",
  "license": "BUSL-1.1",
  "platforms": ["darwin-arm64", "darwin-x64", "win32-x64"],
  "repository": "https://github.com/gainmedialab/rf_explorer_pro_audio_plugin",
  "maintainers": [{ "name": "Gain Media Lab", "email": "info@gainmedialab.com" }],
  "contract": {
    "core": "1.4",
    "modules": { "SpectrumAnalyzer": "1.2" }
  },
  "runtime": { "type": "node", "entrypoint": "main.js" },
  "deployment": ["managed"],
  "template": { "name": "soundbase-plugin-template", "version": "1.0.15" },
  "products": [
    {
      "deviceTypeId": "plugin:rf-explorer-pro-audio/pro-audio",
      "manufacturer": { "id": "rf-explorer", "name": "RF Explorer" },
      "model": {
        "id": "pro-audio",
        "name": "Pro Audio Edition",
        "displayName": "RF Explorer Pro Audio Edition"
      },
      "family": { "id": "rf-explorer", "name": "RF Explorer" },
      "capabilities": { "spectrumAnalyzer": true },
      "traits": { "isSpectrumAnalyzer": true }
    }
  ],
  "deviceConfigFields": [
    {
      "id": "serialPath",
      "type": "textinput",
      "label": "Serial port",
      "required": true,
      "manualOnly": true,
      "help": "e.g. /dev/tty.SLAB_USBtoUART, /dev/tty.usbserial-1210 or COM5"
    }
  ],
  "stateKeys": []
}
